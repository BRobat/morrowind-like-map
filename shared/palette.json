  "land": [
    { "elevation": 0,    "color": "#E2D2AA" },
    { "elevation": 60,   "color": "#D5C196" },
    { "elevation": 150,  "color": "#C6AC7E" },
    { "elevation": 300,  "color": "#B19366" },
    { "elevation": 500,  "color": "#987A50" },
    { "elevation": 800,  "color": "#7D603E" },
    { "elevation": 1200, "color": "#62492E" },
